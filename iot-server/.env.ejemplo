# Copia este archivo como .env y llénalo. El .env no se sube a GitHub.

# Token que te da @BotFather al crear el bot
TELEGRAM_TOKEN=

# Número del chat o grupo que recibe las alertas (lo muestra `npm run telegram`).
# Varios chats separados por coma.
TELEGRAM_CHAT_ID=

# Límites de nivel crítico
UMBRAL_TURBIDEZ=50
UMBRAL_TDS=500

# Cada cuántos minutos se repite el aviso si el lago sigue en nivel crítico
REPETIR_MIN=10
# Cuántos recordatorios como máximo por cada alerta (después, silencio hasta que se recupere)
MAX_RECORDATORIOS=2
